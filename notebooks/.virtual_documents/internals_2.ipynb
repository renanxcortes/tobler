import pandas as pd


# Functions that appends a "Type_" suffix on any numeric column
def rename_type(df):
    res = df.rename(
    columns=lambda col: (
        f"Type_{int(pd.to_numeric(col))}"
        if not isinstance(col, bool)
        and pd.notna(pd.to_numeric(col, errors="coerce"))
        and float(pd.to_numeric(col)).is_integer()
        else col
    ))
    return res


