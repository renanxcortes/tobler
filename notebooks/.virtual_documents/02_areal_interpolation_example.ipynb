


import matplotlib.pyplot as plt

import tobler

%matplotlib inline


import geopandas


tracts = geopandas.read_file("https://ndownloader.figshare.com/files/20460645")


tracts.shape





tracts.head()


tracts.plot(facecolor="none", edgecolor="g")





precincts = geopandas.read_file("https://ndownloader.figshare.com/files/20460549")


precincts.shape





precincts.plot(facecolor="none", edgecolor="r")





estimates = tobler.area_weighted.area_interpolate(
    tracts, precincts, intensive_variables=["pct Youth"]
)





estimates





tracts = tracts.to_crs(precincts.crs)


estimates = tobler.area_weighted.area_interpolate(
    tracts, precincts, intensive_variables=["pct Youth"]
)


estimates


f, ax = plt.subplots(1, figsize=(8, 8))
ax = tracts.plot(
    column="pct Youth", ax=ax, legend=True, alpha=0.5, scheme="Quantiles", k=10
)
plt.show()


precincts["pct Youth"] = estimates["pct Youth"]
f, ax = plt.subplots(1, figsize=(8, 8))
ax = precincts.plot(
    column="pct Youth", ax=ax, legend=True, alpha=0.5, scheme="Quantiles", k=10
)
plt.show()






